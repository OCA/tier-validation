<odoo>
    <record id="tier_correction_view_tree" model="ir.ui.view">
        <field name="name">tier.correction.list</field>
        <field name="model">tier.correction</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state == 'draft'"
                decoration-muted="state in ['done', 'cancel', 'revert']"
            >
                <field name="name" decoration-bf="1" />
                <field name="correction_type" />
                <field name="model_id" />
                <field name="reference" />
                <field name="create_uid" widget="many2one_avatar_user" />
                <field name="create_date" optional="show" />
                <field
                    name="state"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'prepare'"
                    decoration-success="state == 'done'"
                    decoration-danger="state in ['cancel', 'revert']"
                    widget="badge"
                />
            </list>
        </field>
    </record>
    <record id="tier_correction_view_form" model="ir.ui.view">
        <field name="name">tier.correction.form</field>
        <field name="model">tier.correction</field>
        <field name="arch" type="xml">
            <form string="Tier Correction">
                <header>
                    <button
                        name="action_prepare"
                        invisible="state != 'draft'"
                        type="object"
                        string="Prepare"
                        class="oe_highlight"
                    />
                    <button
                        name="action_done"
                        invisible="state != 'prepare'"
                        type="object"
                        string="Make Correction"
                        class="oe_highlight"
                        confirm="Are you sure to reassign new reviewer(s) for affected tier reviews?"
                    />
                    <button
                        name="action_revert"
                        invisible="state != 'done'"
                        type="object"
                        string="Revert Back"
                        confirm="Are you sure to revert to old reviewer(s) for affected tier reviews?"
                    />
                    <button
                        name="action_draft"
                        invisible="state != 'prepare'"
                        type="object"
                        string="Set to Draft"
                    />
                    <button
                        name="action_cancel"
                        invisible="state in ['draft', 'prepare']"
                        type="object"
                        string="Cancel"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,prepare,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not document_count"
                        >
                            <field
                                name="document_count"
                                widget="statinfo"
                                string="Documents"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                required="1"
                                readonly="state != 'draft'"
                                placeholder="e.g. Correction for..."
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="correction_type" readonly="state != 'draft'" />
                            <field
                                name="model_id"
                                required="1"
                                readonly="state != 'draft'"
                                widget="selection"
                            />
                            <field name="model" invisible="1" />
                        </group>
                    </group>
                    <group name="search" string="Find documents with open reviews">
                        <p class="text-muted" colspan="2">
                            Optional. Leave empty to include every document of this model
                            with a review that is waiting or pending.
                        </p>
                        <field
                            name="old_reviewer_ids"
                            readonly="state != 'draft'"
                            widget="many2many_avatar_user"
                            string="Current Reviewer(s)"
                        />
                        <field
                            name="document_domain"
                            widget="domain"
                            options="{'model': 'model'}"
                            readonly="state != 'draft'"
                        />
                    </group>
                    <group name="set_value" string="Reassign to">
                        <p class="text-muted" colspan="2">
                            The new reviewers for the documents found. You can still change
                            them per document under Correction Details.
                        </p>
                        <field
                            name="new_reviewer_ids"
                            readonly="state != 'draft'"
                            widget="many2many_avatar_user"
                            string="New Reviewer(s)"
                            invisible="correction_type != 'reviewer'"
                            required="correction_type == 'reviewer'"
                        />
                    </group>
                    <notebook>
                        <page name="correction_item" string="Correction Details">
                            <field
                                name="item_ids"
                                readonly="state not in ['draft', 'prepare']"
                            >
                                <list create="0" editable="bottom">
                                    <field
                                        name="resource_ref"
                                        string="Document"
                                        decoration-bf="1"
                                    />
                                    <field
                                        name="new_reviewer_ids"
                                        widget="many2many_avatar_user"
                                    />
                                    <field
                                        name="review_ids"
                                        widget="many2many_tags"
                                        readonly="1"
                                    />
                                    <button
                                        name="action_open_document"
                                        string="Open Document"
                                        type="object"
                                        icon="fa-external-link"
                                        class="btn-link"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Scheduled Action">
                            <div class="oe_grey" colspan="4">
                                Scheduled date/time to auto correct and/or revert by
                                <button
                                name="%(view_affected_tier_reviews_action)d"
                                string="Scheduled Action"
                                type="action"
                                icon="fa-clock-o"
                                class="oe_inline"
                            />
                            </div>
                            <group>
                                <group>
                                    <field
                                        name="date_schedule_correct"
                                        readonly="state not in ['draft', 'prepare']"
                                        string="Scheduled Correct"
                                    />
                                    <field
                                        name="date_actual_correct"
                                        string="Actual Correct"
                                        invisible="not date_actual_correct"
                                        readonly="1"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="date_schedule_revert"
                                        readonly="state not in ['draft', 'prepare', 'done']"
                                        string="Scheduled Revert"
                                    />
                                    <field
                                        name="date_actual_revert"
                                        string="Actual Revert"
                                        invisible="not date_actual_correct"
                                        readonly="1"
                                    />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter />
            </form>
        </field>
    </record>
    <record id="tier_correction_item_view_form" model="ir.ui.view">
        <field name="name">tier.correction.item.form</field>
        <field name="model">tier.correction.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_document"
                        string="Open Document"
                        type="object"
                        icon="fa-external-link"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="resource_ref" string="Document" />
                            <field
                                name="new_reviewer_ids"
                                widget="many2many_avatar_user"
                                readonly="correction_state not in ['draft', 'prepare']"
                            />
                        </group>
                        <group>
                            <field name="correction_id" readonly="1" />
                            <field name="correction_state" />
                        </group>
                    </group>
                    <field name="review_ids" readonly="1" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="tier_correction_view_search" model="ir.ui.view">
        <field name="name">tier.correction.search</field>
        <field name="model">tier.correction</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Correction"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('model_id', 'ilike', self)]"
                />
                <field
                    name="old_reviewer_ids"
                    string="Reviewer"
                    filter_domain="['|', ('old_reviewer_ids', 'ilike', self), ('new_reviewer_ids', 'ilike', self)]"
                />
                <field name="model_id" />
                <filter
                    string="My Corrections"
                    name="my_corrections"
                    domain="[('create_uid', '=', uid)]"
                />
                <separator />
                <filter
                    string="Change Reviewers"
                    name="reviewer"
                    domain="[('correction_type', '=', 'reviewer')]"
                />
                <separator />
                <filter
                    string="Draft"
                    name="state_draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Preparing"
                    name="state_prepare"
                    domain="[('state', '=', 'prepare')]"
                />
                <filter
                    string="Corrected"
                    name="state_done"
                    domain="[('state', '=', 'done')]"
                />
                <filter
                    string="Cancelled"
                    name="state_cancel"
                    domain="[('state', '=', 'cancel')]"
                />
                <filter
                    string="Reverted"
                    name="state_revert"
                    domain="[('state', '=', 'revert')]"
                />
                <group>
                    <filter
                        string="Status"
                        name="group_state"
                        domain="[]"
                        context="{'group_by':'state'}"
                    />
                    <filter
                        string="Correction Type"
                        name="group_correction_type"
                        domain="[]"
                        context="{'group_by':'correction_type'}"
                    />
                    <filter
                        string="Model"
                        name="group_model"
                        domain="[]"
                        context="{'group_by':'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="tier_correction_action" model="ir.actions.act_window">
        <field name="name">Tier Review Correction</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tier.correction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Reassign the reviewers of open tier reviews
            </p>
            <p>
                A correction finds the documents with waiting or pending reviews,
                for example those of a colleague who left, and gives them new
                reviewers. It can be applied and reverted by hand, or at dates
                you schedule.
            </p>
            <p>
                From a document under review, the
                <em>Change Reviewer</em>
                button starts a correction for that document.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_tier_correction"
        parent="base_tier_validation.menu_tier_confirmation"
        action="tier_correction_action"
        groups="base_tier_validation_correction.group_tier_correction"
    />
</odoo>
