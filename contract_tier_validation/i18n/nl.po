#. module: contract_tier_validation
#. odoo-python
#: code:addons/contract_tier_validation/models/contract_line.py:0
msgid ""
"Lines cannot be added to or removed from a validated contract.\n"
"\n"
"Set the contract back to draft to change its terms, or turn off 'Lock contract lines after validation' in the contract settings."
msgstr ""
"Aan een gevalideerd contract kunnen geen regels worden toegevoegd of verwijderd.\n"
"\n"
"Zet het contract terug naar concept om de voorwaarden te wijzigen, of zet 'Contractregels vergrendelen na validatie' uit in de contractinstellingen."

#. module: contract_tier_validation
#: model:ir.model.fields,field_description:contract_tier_validation.field_res_company__contract_lock_lines_after_validation
#: model:ir.model.fields,field_description:contract_tier_validation.field_res_config_settings__contract_lock_lines_after_validation
#: model_terms:ir.ui.view,arch_db:contract_tier_validation.res_config_settings_view_form
msgid "Lock contract lines after validation"
msgstr "Contractregels vergrendelen na validatie"

